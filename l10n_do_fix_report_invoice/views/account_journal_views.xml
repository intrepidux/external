<odoo>
    <data>
        <record id="view_account_journal_form_inherit_l10n_do_fix" model="ir.ui.view">
            <field name="name">account.journal.form.inherit.l10n.do.fix</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='type']" position="after">
                    <field name="l10n_do_is_shared_sequence_source"
                        invisible="type not in ['sale']" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>