<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_sequence_warning" model="mail.template">
            <field name="name">Aviso Comprobantes Agotándose</field>
            <field name="model_id" ref="l10n_do_sequence_inherit.model_l10n_sequence_max"/>
            <field name="email_from">{{object.company_id.email}}</field>
            <field name="email_to">{{object.user_id.email}}</field>
            <field name="subject">{{'Aviso Comprobantes Agotándose'}}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="xml">
                <div style="background:#F0F0F0;color:#515166;padding:10px 0px;font-family:Arial,Helvetica,sans-serif;font-size:14px;">
                    <table style="width:600px;margin:5px auto;">
                        <tbody>
                            <tr><td></td>
                                <td style="text-align:center;vertical-align:middle;">
                                    El comprobante de <t t-out="object.document_type_id.name"/>, se está por agotar, ¡favor de estar al pendiente!
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </field>
        </record>
    </data>
</odoo>
