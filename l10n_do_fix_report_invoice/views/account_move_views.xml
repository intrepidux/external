<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_move_form_webpos_api_print" model="ir.ui.view">
        <field name="name">account.move.form.webpos.api.print</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="webpos_api_pdf_ready" invisible="1"/>
            </xpath>
            <xpath expr="//header/button[@name='action_print_pdf'][last()]" position="after">
                <button name="action_print_webpos_api_pdf"
                        type="object"
                        string="PDF WebPOS"
                        class="btn-secondary"
                        groups="account.group_account_invoice"
                        invisible="state != 'posted' or not journal_id.is_webpos or not is_ecf_invoice or not webpos_api_pdf_ready"/>
            </xpath>
        </field>
    </record>

</odoo>
