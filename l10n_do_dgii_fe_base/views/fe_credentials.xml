<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="action_itx_fe_dgii" model="ir.actions.act_window">
            <field name="name">Maestro de facturacion electronica DGII</field>
            <field name="res_model">itx.fe.dgii</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="view_itx_fe_dgii_tree" model="ir.ui.view">
            <field name="name">itx.fe.dgii.tree</field>
            <field name="model">itx.fe.dgii</field>
            <field name="arch" type="xml">
                <tree decoration-muted="status_color == 0"
                      decoration-warning="status_color == 3"
                      decoration-success="status_color == 5">
                    <field name="name"/>
                    <field name="company_id"/>
                    <field name="rnc"/>
                    <field name="api_sync_state"/>
                    <field name="dgii_environment"/>
                    <field name="dgii_client_mode" decoration-success="dgii_client_mode == 'prod'" decoration-warning="dgii_client_mode == 'test'"/>
                    <field name="active"/>
                    <field name="status_color" invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="view_itx_fe_dgii_form" model="ir.ui.view">
            <field name="name">itx.fe.dgii.form</field>
            <field name="model">itx.fe.dgii</field>
            <field name="arch" type="xml">
                <form string="Maestro de facturacion electronica DGII">
                    <header>
                        <button name="action_sync_api_client"
                                string="Sincronizar con API"
                                type="object"
                                class="btn-primary"
                                icon="fa-cloud-upload"/>
                        <button name="action_test_connection"
                                string="Probar Conexion"
                                type="object"
                                class="btn-secondary"
                                icon="fa-plug"/>
                    </header>
                    <sheet>
                        <div class="alert alert-warning"
                             role="alert"
                             invisible="active">
                            <strong>Registro Inactivo</strong><br/>
                            Este registro esta marcado como inactivo. Active para usarlo.
                        </div>

                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="company_id"/>
                        </group>

                        <div class="alert alert-warning mb-0"
                             role="alert"
                             invisible="not is_test_mode">
                            <strong><i class="fa fa-exclamation-triangle"></i> Modo Prueba Activo</strong><br/>
                            <ul class="mb-0">
                                <li>Las facturas <strong>NO</strong> se enviaran a DGII real</li>
                                <li>Sin sync: puede usar certificado legacy en cada request</li>
                            </ul>
                        </div>

                        <div class="alert alert-success mb-0"
                             role="alert"
                             invisible="is_test_mode">
                            <strong><i class="fa fa-check-circle"></i> Modo Produccion</strong><br/>
                            El certificado se firma en el servidor API tras <strong>Sincronizar con API</strong>.
                            No se envia P12 en cada factura.
                        </div>

                        <group string="Configuracion de Operacion">
                            <field name="dgii_client_mode"
                                   widget="radio"
                                   options="{'horizontal': True}"/>
                            <field name="is_test_mode" invisible="1"/>
                            <field name="api_base_url"/>
                            <field name="cert_storage_mode"/>
                            <field name="dgii_validate_xsd"/>
                        </group>

                        <group string="Conexion API (tenant)">
                            <group>
                                <field name="api_provisioning_key" password="True"/>
                                <field name="api_client_id" readonly="1"/>
                                <field name="api_key" password="True"/>
                                <field name="api_sync_state" readonly="1"/>
                                <field name="api_last_sync" readonly="1"/>
                            </group>
                            <group>
                                <field name="allow_inbound_fe"/>
                                <field name="allow_inbound_auth"/>
                            </group>
                            <field name="api_sync_message" readonly="1" colspan="2"/>
                        </group>

                        <group string="URLs portal CerteCF (servidor API)" colspan="2">
                            <field name="url_recepcion" readonly="1"/>
                            <field name="url_aprobacion_comercial" readonly="1"/>
                            <field name="url_autenticacion" readonly="1"/>
                        </group>

                        <group string="Credenciales DGII">
                            <group>
                                <field name="rnc"
                                       placeholder="Ej: 101123456"
                                       required="dgii_client_mode == 'prod'"/>
                            </group>
                            <group>
                                <field name="dgii_environment"
                                       readonly="dgii_client_mode == 'test'"
                                       required="dgii_client_mode == 'prod'"
                                       options="{'no_create': True}"/>
                            </group>
                        </group>

                        <group string="Certificado Digital">
                            <field name="certificate_filename" invisible="1"/>
                            <field name="certificate_file"
                                   filename="certificate_filename"
                                   widget="binary"
                                   required="cert_storage_mode != 'remote_only' or api_sync_state != 'synced'"/>
                            <field name="certificate_password"
                                   password="True"
                                   required="cert_storage_mode != 'remote_only' or api_sync_state != 'synced'"/>
                            <button name="action_validate_certificate"
                                    string="Validar Certificado"
                                    type="object"
                                    class="btn-secondary"
                                    icon="fa-check-circle"/>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
