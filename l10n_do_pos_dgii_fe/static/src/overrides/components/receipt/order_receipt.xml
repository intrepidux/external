<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="point_of_sale.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('before-footer')]" position="inside">
            <t t-if="props.data.itx_dgii_electronic_stamp">
                <br/><br/>
                <div style="display: flex; justify-content: center;">
                    <img t-att-src="'/report/barcode/?barcode_type=QR&amp;width=100&amp;height=100&amp;value=' + props.data.itx_dgii_electronic_stamp"/>
                </div>
                <t t-if="props.data.l10n_do_ecf_security_code">
                    <div style="display: flex; justify-content: center;">
                        <strong>Código de Seguridad:</strong>
                        <span t-esc="props.data.l10n_do_ecf_security_code"/>
                    </div>
                </t>
                <t t-if="props.data.l10n_do_ecf_sign_date">
                    <div style="display: flex; justify-content: center;">
                        <strong>Fecha Firma Digital:</strong>
                        <span t-esc="props.data.l10n_do_ecf_sign_date"/>
                    </div>
                </t>
            </t>
        </xpath>
    </t>
</templates>
