<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Logo en header (custom_header): más grande + menos hueco bajo el logo. -->
    <template id="webpos_ecf_custom_header">
        <div class="o_webpos_ecf_header_logo">
            <img t-if="o.company_id.logo"
                 class="o_webpos_ecf_logo"
                 t-att-src="image_data_uri(o.company_id.logo)"
                 alt="Logo"/>
        </div>
    </template>

    <template id="report_invoice_document_webpos_ecf_layout"
              inherit_id="l10n_do_fix_report_invoice.report_invoice_document_webpos_ecf">

        <xpath expr="//div[hasclass('invoice_main')]" position="attributes">
            <attribute name="class" add="o_webpos_ecf_invoice" separator=" "/>
        </xpath>

        <xpath expr="//div[hasclass('page') and hasclass('mb-4')]" position="attributes">
            <attribute name="class">page mb-1</attribute>
        </xpath>

        <!-- Core instalado: #total.mt-n3 pega el cuadro a las líneas. -->
        <xpath expr="//div[@id='total']" position="attributes">
            <attribute name="class">clearfix row</attribute>
        </xpath>
        <xpath expr="//div[@id='right-elements']" position="attributes">
            <attribute name="t-attf-class">#{'col-5 o_webpos_ecf_totals_gap' if report_type != 'html' else 'col-12 col-md-5'} ms-5 d-inline-block float-end</attribute>
        </xpath>

        <!-- Referencia de pago bajo el QR (no en payment_term al lado del float) -->
        <xpath expr="//div[@id='payment_term']/div[.//p[@name='payment_communication']]" position="replace"/>

    </template>

    <template id="report_invoice_document_webpos_ecf_stamp"
              inherit_id="l10n_do_fix_report_invoice.report_invoice_document_webpos_ecf">

        <xpath expr="//div[@id='right-elements']" position="before">
            <div id="webpos_ecf_stamp"
                 t-if="o.l10n_do_webpos_electronic_stamp"
                 t-attf-class="float-start avoid-page-break-inside o_webpos_ecf_totals_gap"
                 style="text-align: left; max-width: 55%;">
                <div>
                    <div style="display: inline-block; vertical-align: top;">
                        <img t-if="o.l10n_do_webpos_electronic_stamp_encoded"
                             alt="QR e-CF"
                             t-att-src="'/report/barcode/?barcode_type=QR&amp;width=100&amp;height=100&amp;value=' + o.l10n_do_webpos_electronic_stamp_encoded"/>
                    </div>
                    <div style="display: inline-block; vertical-align: top; margin-left: 10px;">
                        <t t-if="o.l10n_do_ecf_security_code">
                            <strong>Código de Seguridad:</strong><br/>
                            <span t-out="o.l10n_do_ecf_security_code"/>
                        </t>
                        <br t-if="o.l10n_do_ecf_security_code and o.l10n_do_ecf_sign_date"/>
                        <t t-if="o.l10n_do_ecf_sign_date">
                            <strong>Fecha Firma Digital:</strong><br/>
                            <span t-out="context_timestamp(o.l10n_do_ecf_sign_date).strftime('%d-%m-%Y %H:%M:%S')"/>
                        </t>
                    </div>
                </div>
                <div class="mt-3"
                     t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference">
                    <p name="payment_communication" class="mb-0">
                        Referencia de pago:
                        <span class="fw-bold" t-field="o.payment_reference"/>
                        <t t-if="o.partner_bank_id">
                            <br/>
                            en esta cuenta:
                            <span t-field="o.partner_bank_id" class="fw-bold"/>
                        </t>
                    </p>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
