<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_ecf_sequences" model="ir.ui.view">
        <field name="name">res.company.form.ecf.sequences</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="l10n_do_ecf_issuer" />
                <field name="l10n_do_fiscal_sequence_mode" readonly="not l10n_do_ecf_issuer"/>
            </xpath>
        </field>
    </record>
</odoo>
