<odoo>
  <data>
      <record id="l10n_do_sequence_view_tree" model="ir.ui.view">
        <field name="name">l10n_do_sequence_view_tree</field>
        <field name="model">l10n.sequence.max</field>
        <field name="arch" type="xml">
            <tree string="Sequence Max">
                <field name="document_type_id"/> 
                <field name="company_id"/>
                <field name="max"/>
                <field name="max_alert"/>
                <field name="user_id"/>
            </tree>
          </field>
      </record>
      
      <record id="l10n_do_sequence_view_form" model="ir.ui.view">
        <field name="name">l10n_do_sequence_view_form</field>
        <field name="model">l10n.sequence.max</field>
        <field name="arch" type="xml">
            <form string="sequence_form">
                <sheet>
                    <group>
                        <field name="document_type_id"/>
                    </group>
                    <group><field name="company_id"/></group>
                     <group> <field name="max"/></group>
                     <group> <field name="max_alert"/></group>
                     <group> <field name="user_id" string="Usuario Aviso"/></group>
                    
                       
                </sheet>
            </form>
        </field>
    </record>
      
      <record id="sequence_action" model="ir.actions.act_window">
                <field name="name">sequence_action_name</field>
                <field name="type">ir.actions.act_window</field>
                <field name="res_model">l10n.sequence.max</field>
                <field name="view_mode">tree,form</field>
            </record>
      
      <menuitem id="l10n_do_sequence_inherit_root" name="menu_root" />
      <menuitem id="sequence_menu"
                name="Secuencia maxima"
                parent="account.account_account_menu"
                action="sequence_action"
                sequence="21"/>

      <!-- Extension to account.move form to show sequence alerts -->
      <record id="view_move_form_sequence_alert" model="ir.ui.view">
        <field name="name">account.move.form.sequence.alert</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
          <xpath expr="//sheet" position="inside">
            <field name="sequence_alert_level" invisible="1"/>
            <field name="sequence_alert_message" invisible="1"/>
          </xpath>
          <xpath expr="//sheet" position="before">
            <div class="alert alert-warning" role="alert"
                 invisible="sequence_alert_level != 'warning'">
              <i class="fa fa-exclamation-triangle" title="Advertencia"></i>
              <field name="sequence_alert_message" readonly="1" class="ms-2"/>
            </div>
            <div class="alert alert-danger" role="alert"
                 invisible="sequence_alert_level != 'danger'">
              <i class="fa fa-exclamation-circle" title="Alerta de Peligro"></i>
              <field name="sequence_alert_message" readonly="1" class="ms-2"/>
            </div>
          </xpath>
        </field>
      </record>
  </data>
</odoo>
