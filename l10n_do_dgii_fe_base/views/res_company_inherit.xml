<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_company_form_inherit_fe_credentials" model="ir.ui.view">
            <field name="name">company.form.inherit.fe.credentials</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="FE credenciales">
                        <field name="fe_dgii_id" context="{'default_company_id': id}">
                            <form>
                                <group>
                                    <field name="name" placeholder="Nombre"/>
                                    <field name="active" placeholder="activado"/>
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>