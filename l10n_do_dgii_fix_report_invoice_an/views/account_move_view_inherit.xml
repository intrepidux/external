<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_latam_document_number']" position="replace">
                <field name="l10n_latam_document_number"
                       string="Numero de Comprobante"
                       attrs="{
                           'invisible': ['|', '|',
                               ('l10n_latam_use_documents', '=', False),
                               '&amp;', ('state', '=', 'draft'), ('l10n_latam_manual_document_number', '=', False),
                               ('l10n_latam_country_code', '!=', 'DO')],
                           'required': [('l10n_latam_manual_document_number', '=', True), ('l10n_latam_use_documents', '=', True), ('l10n_latam_country_code', '=', 'DO')],
                           'readonly': [('state', '!=', 'draft')]
                       }"/>
            </xpath>
        </field>
    </record>
</odoo>