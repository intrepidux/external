<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Indexa l10n_do_accounting fields -->
    <record id="view_account_move_reversal_webpos_simplified_indexa" model="ir.ui.view">
        <field name="name">account.move.reversal.form.webpos.simplified.indexa</field>
        <field name="model">account.move.reversal</field>
        <field name="priority" eval="200"/>
        <field name="inherit_id" ref="l10n_do_accounting.view_account_move_reversal_inherited"/>
        <field name="arch" type="xml">
            <field name="move_ids" position="after">
                <field name="bmc_is_webpos_reversal" invisible="1"/>
                <field name="bmc_nc_warning_over_30" invisible="1"/>
                <field name="bmc_nc_days_diff" invisible="1"/>
                <field name="bmc_nc_original_invoice" invisible="1"/>
                <field name="bmc_nc_original_date" invisible="1"/>
            </field>

            <xpath expr="//field[@name='l10n_do_refund_type']" position="attributes">
                <attribute name="attrs">{'invisible': [('bmc_is_webpos_reversal', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='l10n_do_refund_action']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('bmc_is_webpos_reversal', '=', True), ('l10n_do_refund_type', '=', 'full_refund')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='l10n_do_percentage']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('bmc_is_webpos_reversal', '=', True), ('l10n_do_refund_type', '!=', 'percentage')], 'required': [('bmc_is_webpos_reversal', '=', False), ('l10n_do_refund_type', '=', 'percentage')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='l10n_do_amount']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('bmc_is_webpos_reversal', '=', True), ('l10n_do_refund_type', '!=', 'fixed_amount')], 'required': [('bmc_is_webpos_reversal', '=', False), ('l10n_do_refund_type', '=', 'fixed_amount')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='l10n_do_ecf_modification_code']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('bmc_is_webpos_reversal', '=', True), '|', ('l10n_latam_manual_document_number', '=', True), ('is_ecf_invoice', '=', False)], 'required': [('bmc_is_webpos_reversal', '=', False), ('l10n_latam_manual_document_number', '=', False), ('is_ecf_invoice', '=', True)]}</attribute>
            </xpath>

            <xpath expr="//field[@name='refund_method']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('bmc_is_webpos_reversal', '=', True), ('l10n_do_refund_type', '!=', 'full_refund')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='date_mode']" position="attributes">
                <attribute name="attrs">{'invisible': [('bmc_is_webpos_reversal', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="attrs">{'readonly': [('bmc_is_webpos_reversal', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='l10n_latam_document_type_id']" position="attributes">
                <attribute name="attrs">{'invisible': ['&amp;', ('bmc_is_webpos_reversal', '=', False), '|', '&amp;', ('refund_method', '=', 'refund'), ('country_code', '!=', 'DO'), ('move_type', '=', 'out_invoice')], 'required': [('bmc_is_webpos_reversal', '=', False), ('l10n_latam_use_documents', '=', True), ('refund_method', '!=', 'refund')], 'readonly': [('bmc_is_webpos_reversal', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='l10n_latam_document_number']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('bmc_is_webpos_reversal', '=', True), ('l10n_latam_manual_document_number', '=', False)], 'required': [('bmc_is_webpos_reversal', '=', False), ('move_type', '=', 'in_invoice'), ('l10n_latam_manual_document_number', '=', True)]}</attribute>
            </xpath>

            <xpath expr="//form/group/*[2]" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('bmc_is_webpos_reversal', '=', True), ('l10n_do_refund_type', '!=', 'full_refund')]}</attribute>
            </xpath>
            <xpath expr="//form/group/*[2]/following-sibling::group[1]" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('bmc_is_webpos_reversal', '=', True), ('l10n_do_refund_type', '=', 'full_refund')]}</attribute>
            </xpath>

            <xpath expr="//field[@name='date']" position="after">
                <div class="alert alert-warning mb-0" colspan="2" role="alert"
                     attrs="{'invisible': [('bmc_nc_warning_over_30', '=', False)]}">
                    <strong>Advertencia: Nota de Crédito de más de 30 días</strong>
                    <ul class="mb-0 mt-2">
                        <li>Factura Original: <field name="bmc_nc_original_invoice" readonly="1" class="oe_inline"/> (<field name="bmc_nc_original_date" readonly="1" class="oe_inline"/>)</li>
                        <li>Fecha de NC: <field name="date" readonly="1" class="oe_inline"/></li>
                        <li>Diferencia: <field name="bmc_nc_days_diff" readonly="1" class="oe_inline"/> días</li>
                    </ul>
                    <p class="mb-0 mt-2">
                        Según normativa DGII, las Notas de Crédito emitidas con más de 30 días
                        de la factura original no podrán incluir ITBIS. Los impuestos se
                        modificarán automáticamente a EXENTO (0%).
                    </p>
                </div>
            </xpath>
        </field>
    </record>

    <!-- accounting_update duplicate refund fields -->
    <record id="view_account_move_reversal_webpos_simplified_update" model="ir.ui.view">
        <field name="name">account.move.reversal.form.webpos.simplified.update</field>
        <field name="model">account.move.reversal</field>
        <field name="priority" eval="200"/>
        <field name="inherit_id" ref="l10n_do_accounting_update.view_account_move_reversal_inherited"/>
        <field name="arch" type="xml">
            <field name="move_ids" position="after">
                <field name="bmc_is_webpos_reversal" invisible="1"/>
                <field name="bmc_nc_warning_over_30" invisible="1"/>
                <field name="bmc_nc_days_diff" invisible="1"/>
                <field name="bmc_nc_original_invoice" invisible="1"/>
                <field name="bmc_nc_original_date" invisible="1"/>
            </field>

            <xpath expr="//field[@name='refund_type']" position="attributes">
                <attribute name="attrs">{'invisible': [('bmc_is_webpos_reversal', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='refund_action']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('bmc_is_webpos_reversal', '=', True), ('refund_type', '=', 'full_refund')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='percentage']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('bmc_is_webpos_reversal', '=', True), ('refund_type', '!=', 'percentage')], 'required': [('bmc_is_webpos_reversal', '=', False), ('refund_type', '=', 'percentage')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('bmc_is_webpos_reversal', '=', True), ('refund_type', '!=', 'fixed_amount')], 'required': [('bmc_is_webpos_reversal', '=', False), ('refund_type', '=', 'fixed_amount')]}</attribute>
            </xpath>

            <xpath expr="//field[@name='refund_method']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('bmc_is_webpos_reversal', '=', True), ('refund_type', '!=', 'full_refund')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='date_mode']" position="attributes">
                <attribute name="attrs">{'invisible': [('bmc_is_webpos_reversal', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="attrs">{'readonly': [('bmc_is_webpos_reversal', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='l10n_latam_document_type_id']" position="attributes">
                <attribute name="attrs">{'invisible': ['&amp;', ('bmc_is_webpos_reversal', '=', False), '|', '&amp;', ('refund_method', '=', 'refund'), ('l10n_latam_country_code', '!=', 'DO'), ('l10n_latam_country_code', '=', 'DO')], 'required': [('bmc_is_webpos_reversal', '=', False), ('l10n_latam_use_documents', '=', True), ('refund_method', '!=', 'refund')], 'readonly': [('bmc_is_webpos_reversal', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='l10n_latam_document_number']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('bmc_is_webpos_reversal', '=', True), ('l10n_latam_sequence_id', '!=', False)], 'required': [('bmc_is_webpos_reversal', '=', False), ('move_type', '=', 'in_invoice'), ('l10n_latam_sequence_id', '=', False)]}</attribute>
            </xpath>

            <xpath expr="//form/group/*[2]" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('bmc_is_webpos_reversal', '=', True), ('refund_type', '!=', 'full_refund')]}</attribute>
            </xpath>
            <xpath expr="//form/group/*[2]/following-sibling::group[1]" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('bmc_is_webpos_reversal', '=', True), ('refund_type', '=', 'full_refund')]}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
