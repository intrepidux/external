<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="external_layout_standard_inherited" inherit_id="web.external_layout_standard">

        <xpath expr="//div[hasclass('o_footer_content')]/div[1]" position="before">

            <!-- BLOQUE QR (IZQUIERDA) -->
            <div t-if="o and 'l10n_do_electronic_stamp' in o and o.l10n_do_electronic_stamp"
                style="min-width: 260px; margin-right: 10px; padding-right: 10px; border-right: 1px solid #ccc;">

                <div style="text-align: left;">

                    <!-- QR -->
                    <div style="display: inline-block; vertical-align: top;">
                        <img alt="Barcode"
                            style="width: 100px; height: 100px;"
                            t-att-src="'/report/barcode/?barcode_type=QR&amp;width=100&amp;height=100&amp;value=' + o.l10n_do_electronic_stamp"/>
                    </div>

                    <!-- INFO -->
                    <div style="display: inline-block; vertical-align: top; margin-left: 10px;">
                        
                        <!-- Código de Seguridad -->
                        <t t-if="o.l10n_do_ecf_security_code">
                            <strong>Código de Seguridad:</strong><br/>
                            <span t-out="o.l10n_do_ecf_security_code"/>
                        </t>

                        <br/><br/>

                        <!-- Fecha Firma -->
                        <t t-if="o.l10n_do_ecf_sign_date">
                            <strong>Fecha Firma Digital:</strong><br/>
                            <span t-out="context_timestamp(o.l10n_do_ecf_sign_date).strftime('%d-%m-%Y %H:%M:%S')"/>
                        </t>

                    </div>

                </div>

            </div>

        </xpath>
    </template>

</odoo>
