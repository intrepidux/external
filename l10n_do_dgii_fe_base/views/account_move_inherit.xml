        <!-- Action for manual DGII resend (direct call to method) -->
        <record id="action_manual_resend_dgii" model="ir.actions.server">
            <field name="name">Reenviar Documento DGII</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_view_types">form</field>
            <field name="state">code</field>
            <field name="code">
# Action to manually resend DGII document
# This calls the action_manual_resend_dgii method directly on the selected invoice

# Execute the resend action
action = records.action_manual_resend_dgii()
            </field>
            <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        </record>

