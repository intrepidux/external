<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="report_invoice_document_ecf_fix" model="ir.ui.view">
        <field name="inherit_id" ref="web.external_layout_standard"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='text-center']" position="before">
                <div t-if="o and o._name == 'account.move' and o.is_ecf_invoice and (o.itx_dgii_electronic_stamp_encoded or o.l10n_do_ecf_security_code)" style="text-align: left; margin-bottom: 10px;">
                    <div style="display: inline-block; vertical-align: top;">
                        <img t-if="o.itx_dgii_electronic_stamp_encoded" t-att-src="'/report/barcode/?barcode_type=QR&amp;width=100&amp;height=100&amp;value=' + o.itx_dgii_electronic_stamp_encoded"/>
                    </div>
                    <div style="display: inline-block; vertical-align: top; margin-left: 10px;">
                        <t t-if="o.l10n_do_ecf_security_code">
                            <strong>Código de Seguridad:</strong><br/>
                            <span t-esc="o.l10n_do_ecf_security_code"/>
                        </t>
                        <br/>
                        <t t-if="o.l10n_do_ecf_sign_date">
                            <strong>Fecha Firma Digital:</strong><br/>
                            <span t-esc="context_timestamp(o.l10n_do_ecf_sign_date).strftime('%d-%m-%Y %H:%M:%S')"/>
                        </t>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>