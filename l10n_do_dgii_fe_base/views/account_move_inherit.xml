        <record id="view_move_form_ecf_draft_lock" model="ir.ui.view">
            <field name="name">account.move.form.ecf.draft.lock</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="priority">50</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="after">
                    <field name="itx_ecf_lock_draft" invisible="1"/>
                </xpath>
                <xpath expr="//form/sheet/*[1]" position="before">
                    <div class="alert alert-info mb-0" role="alert"
                         attrs="{'invisible': [('itx_ecf_lock_draft', '=', False)]}">
                        e-CF enviado a la DGII. Para corregirlo, registre una nota de crédito (E34) o nota de débito (E33).
                    </div>
                </xpath>
                <xpath expr="//button[@name='button_draft']" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', ('show_reset_to_draft_button', '=', False), ('itx_ecf_lock_draft', '=', True)]}</attribute>
                </xpath>
                <xpath expr="(//form/header/button[@name='button_cancel'])[1]" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', ('itx_ecf_lock_draft', '=', True), '|', '|', ('id', '=', False), ('state', '!=', 'draft'), ('move_type', '!=', 'entry')]}</attribute>
                </xpath>
                <xpath expr="(//form/header/button[@name='button_cancel'])[2]" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', ('itx_ecf_lock_draft', '=', True), '|', '|', ('id', '=', False), '&amp;', ('state', '!=', 'draft'), ('l10n_latam_country_code', '!=', 'DO'), '&amp;', ('state', 'in', ('draft', 'cancel')), ('l10n_latam_country_code', '=', 'DO')]}</attribute>
                </xpath>
                <xpath expr="//button[@name='button_draft']" position="after">
                    <button name="action_ecf_draft_bypass_wizard"
                            type="object"
                            string="Omitir bloqueo e-CF…"
                            groups="l10n_do_dgii_fe_base.group_ecf_draft_bypass"
                            attrs="{'invisible': ['|', ('state', '!=', 'posted'), ('itx_ecf_lock_draft', '=', False)]}"/>
                </xpath>
            </field>
        </record>

