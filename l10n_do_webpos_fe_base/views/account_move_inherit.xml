        <!-- Wizard view for WebPOS resend confirmation -->
        <record id="view_webpos_resend_confirmation_wizard" model="ir.ui.view">
            <field name="name">webpos.resend.confirmation.wizard.form</field>
            <field name="model">webpos.resend.confirmation.wizard</field>
            <field name="arch" type="xml">
                <form string="Confirmar Reenvío WebPOS">
                    <div class="alert alert-warning" role="alert">
                        <strong>⚠️ Acción Técnica</strong><br/>
                        Esta acción solo debe ser ejecutada por administradores del sistema.
                        Reenviar documentos a WebPOS puede afectar el estado fiscal de las facturas.
                    </div>
                    <group>
                        <field name="message" readonly="1" widget="text"/>
                        <field name="invoice_ids" readonly="1" widget="many2many_tags">
                            <tree>
                                <field name="name"/>
                                <field name="l10n_latam_document_number"/>
                                <field name="partner_id"/>
                            </tree>
                        </field>
                    </group>
                    <footer>
                        <button name="action_confirm_resend" string="Confirmar y Reenviar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
