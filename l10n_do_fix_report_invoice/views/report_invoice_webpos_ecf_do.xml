<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="webpos_ecf_fiscal_info">
        <t t-set="webpos_fiscal_number" t-value="o._webpos_ecf_report_fiscal_number()"/>
        <!-- Solo bloques rojos referencia: emisor (izq) + comprobante e-CF (der). -->
        <div id="informations" class="row mt0 mb0 o_webpos_ecf_fiscal_header">
            <div class="col-7 o_webpos_ecf_emitter">
                <div class="o_webpos_ecf_emitter_name fw-bold text-uppercase"
                     t-field="o.company_id.partner_id.name"/>
                <div t-if="o._webpos_ecf_report_company_vat()" class="o_webpos_ecf_line">
                    <span class="o_webpos_ecf_label">RNC:</span>
                    <span t-out="o._webpos_ecf_report_company_vat()"/>
                </div>
                <div class="o_webpos_ecf_line">
                    <span class="o_webpos_ecf_label">Dirección:</span>
                    <span t-field="o.company_id.partner_id" class="text-muted"
                          t-options='{"widget": "contact", "fields": ["address"], "no_marker": true}'/>
                </div>
                <div t-if="o.company_id.phone" class="o_webpos_ecf_line">
                    <span class="o_webpos_ecf_label">Teléfono:</span>
                    <span t-field="o.company_id.phone"/>
                </div>
                <div t-if="o.company_id.email" class="o_webpos_ecf_line">
                    <span class="o_webpos_ecf_label">Correo electrónico:</span>
                    <span t-field="o.company_id.email"/>
                </div>
                <div t-if="o.invoice_date" class="o_webpos_ecf_line">
                    <span class="o_webpos_ecf_label">Fecha de emisión:</span>
                    <span t-out="o.invoice_date.strftime('%d/%m/%Y')"/>
                </div>
            </div>
            <div class="col-5 o_webpos_ecf_doc_box">
                <div class="o_webpos_ecf_doc_title fw-bold text-end"
                     t-out="o._webpos_ecf_report_document_title()"/>
                <div t-if="webpos_fiscal_number" class="o_webpos_ecf_line text-end">
                    <span class="o_webpos_ecf_label">
                        <t t-if="o.is_ecf_invoice">e-NCF:</t>
                        <t t-else="">NCF:</t>
                    </span>
                    <span t-out="webpos_fiscal_number"/>
                </div>
                <div t-if="o._webpos_ecf_report_show_ncf_valid_until()" class="o_webpos_ecf_line text-end">
                    <span class="o_webpos_ecf_label">Fecha de vencimiento:</span>
                    <span t-out="o._webpos_ecf_report_ncf_valid_until()"/>
                </div>
                <div class="o_webpos_ecf_line text-end">
                    <span class="o_webpos_ecf_label">Moneda:</span>
                    <span t-field="o.currency_id.name"/>
                </div>
                <div t-if="(o.move_type in ('out_refund', 'in_refund') or o.debit_origin_id) and o._webpos_ecf_report_origin_ncf()"
                     class="o_webpos_ecf_line text-end">
                    <span class="o_webpos_ecf_label">NCF modificado:</span>
                    <span t-out="o._webpos_ecf_report_origin_ncf()"/>
                </div>
            </div>
        </div>
        <br/>
        <div id="receiver_info" class="row mt0 mb8">
            <t t-set="vat_len" t-value="len(o.commercial_partner_id.vat) if o.commercial_partner_id.vat else 0"/>
            <div class="col-auto col-7 mw-100 mb-2">
                <strong>
                    <t t-if="vat_len == 9">RNC:</t>
                    <t t-elif="vat_len == 11">Cédula:</t>
                    <t t-else="">ID Cliente:</t>
                </strong>
                <span class="m-0" t-esc="o.commercial_partner_id.vat or ''"/>
                <br/>
                <strong>
                    <t t-if="vat_len == 9">Razón Social:</t>
                    <t t-else="">Nombre:</t>
                </strong>
                <t t-if="o.partner_id.is_company or not o.partner_id.parent_id">
                    <span class="m-0" t-field="o.partner_id.name"/>
                </t>
                <t t-else="">
                    <t t-set="commercial_partner_id" t-value="o.partner_id.commercial_partner_id"/>
                    <span class="m-0" t-field="commercial_partner_id.name"/>
                    <br/>
                    <strong>Contacto:</strong>
                    <span t-field="o.partner_id.name"/>
                </t>
            </div>
            <div class="col-auto col-2 mw-100 mb-2" t-if="o.invoice_origin" name="origin">
                <strong>Origen:</strong>
                <p class="m-0" t-field="o.invoice_origin"/>
            </div>
            <div class="col-auto col-2 mw-100 mb-2" t-if="o.ref" name="reference">
                <strong>Referencia:</strong>
                <p class="m-0" t-field="o.ref"/>
            </div>
        </div>
    </template>

    <template id="report_invoice_document_webpos_ecf_do_customize"
              inherit_id="l10n_do_fix_report_invoice.report_invoice_document_webpos_ecf">

        <xpath expr="//t[@t-call='web.external_layout']" position="inside">
            <t t-set="custom_header" t-value="'l10n_do_fix_report_invoice.webpos_ecf_custom_header'"/>
        </xpath>

        <xpath expr="//div[hasclass('row')][1]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <xpath expr="//t[@t-set='layout_document_title']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <xpath expr="//div[@id='informations' and hasclass('mb-4')]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <xpath expr="//div[hasclass('page') and hasclass('mb-4')]/div[hasclass('oe_structure')][1]" position="after">
            <t t-call="l10n_do_fix_report_invoice.webpos_ecf_fiscal_info"/>
        </xpath>

        <!-- Cabeceras tabla: español fijo (el clon no hereda traducciones de account). -->
        <xpath expr="//table[@name='invoice_line_table']//th[@name='th_description']/span" position="replace">
            <span>Descripción</span>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']//th[@name='th_quantity']/span" position="replace">
            <span>Cantidad</span>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']//th[@name='th_priceunit']/span" position="replace">
            <span>Precio unitario</span>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']//th[@name='th_taxes']/span" position="replace">
            <span>Impuestos</span>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']//th[@name='th_subtotal']/span" position="replace">
            <span>Importe</span>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']//th[@name='th_discount']/span" position="replace">
            <span>Desc.%</span>
        </xpath>

        <xpath expr="//table[@name='invoice_line_table']/thead/tr//th[@name='th_discount']" position="after">
            <th t-if="display_discount"
                t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span>Monto desc</span>
            </th>
        </xpath>

        <xpath expr="//table[@name='invoice_line_table']/thead/tr" position="inside">
            <t t-set="has_exempt_itbis" t-value="any(l.price_subtotal == l.price_total for l in o.invoice_line_ids)"/>
            <th t-if="has_exempt_itbis"/>
        </xpath>

        <xpath expr="//table[@name='invoice_line_table']//tbody/t/tr/t//td[@name='td_discount']" position="after">
            <td t-if="display_discount"
                t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <t t-set="discount_amount" t-value="line.price_unit * line.quantity * line.discount / 100"/>
                <span class="text-nowrap" t-out="discount_amount"
                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
            </td>
        </xpath>

        <xpath expr="//table[@name='invoice_line_table']//tbody/t/tr/t" position="inside">
            <td t-if="line.price_subtotal == line.price_total">
                <span><strong>E</strong></span>
            </td>
        </xpath>

        <xpath expr="//p[@t-if='o.company_id.display_invoice_amount_total_words']" position="after">
            <p class="text-end lh-sm" style="float: right;">
                <span><strong>Original: </strong>Cliente</span>
                <br/>
                <span><strong>Copia: </strong>Vendedor</span>
                <br/>
            </p>
        </xpath>

    </template>

</odoo>
